# Docker Image Factory Framework - Environment Variables Example
# Copy this file to .env and fill in your actual values

# General Settings
DOCKER_FACTORY_LOG_DIR=logs
DOCKER_FACTORY_DEFAULT_REGISTRY=dockerhub
DOCKER_FACTORY_SEVERITY_THRESHOLD=HIGH

# Security Scanner Settings
DOCKER_FACTORY_TRIVY_ENABLED=true
DOCKER_FACTORY_SNYK_ENABLED=false
# SNYK_TOKEN=your_snyk_token_here

# Image Signing Settings
DOCKER_FACTORY_SIGNING_METHOD=cosign
# DOCKER_FACTORY_COSIGN_KEY_PATH=/path/to/cosign/key.pem
# DOCKER_FACTORY_DOCKER_TRUST_PASSPHRASE=your_passphrase

# Amazon ECR Settings
# DOCKER_FACTORY_ECR_REPOSITORY_URI=123456789012.dkr.ecr.us-east-1.amazonaws.com
DOCKER_FACTORY_ECR_REGION=us-east-1

# DockerHub Settings
# DOCKER_FACTORY_DOCKERHUB_USERNAME=your_dockerhub_username
# DOCKER_FACTORY_DOCKERHUB_PASSWORD=your_dockerhub_password_or_token

# Slack Notification Settings
DOCKER_FACTORY_SLACK_ENABLED=false
# DOCKER_FACTORY_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Email Notification Settings
DOCKER_FACTORY_EMAIL_ENABLED=false
DOCKER_FACTORY_EMAIL_SMTP_SERVER=smtp.gmail.com
DOCKER_FACTORY_EMAIL_SMTP_PORT=587
# DOCKER_FACTORY_EMAIL_USERNAME=your_email@gmail.com
# DOCKER_FACTORY_EMAIL_PASSWORD=your_app_specific_password
# DOCKER_FACTORY_EMAIL_FROM_EMAIL=your_email@gmail.com
# DOCKER_FACTORY_EMAIL_TO_EMAILS=recipient1@example.com,recipient2@example.com

# Metadata Storage Settings
DOCKER_FACTORY_METADATA_STORAGE_TYPE=local

# AWS S3 Settings (for metadata storage)
# DOCKER_FACTORY_S3_BUCKET_NAME=your-bucket-name
DOCKER_FACTORY_S3_REGION=us-east-1

# AWS DynamoDB Settings (for metadata storage)
# DOCKER_FACTORY_DYNAMODB_TABLE_NAME=your-table-name
DOCKER_FACTORY_DYNAMODB_REGION=us-east-1
